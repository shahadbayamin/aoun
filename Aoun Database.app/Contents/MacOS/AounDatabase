#!/bin/bash
# Opens Aoun's database viewer (http://localhost:5555). Starts Aoun first if it is not running.
ROOT="$(dirname "$(cd "$(dirname "$0")/../.." && pwd)")"
URL="http://localhost:5555"
up() { curl -fs -o /dev/null --max-time 2 "$URL/api/tables"; }
if ! up; then
  osascript -e 'display notification "تشغيل عون… ستفتح قاعدة البيانات بعد قليل / Starting Aoun…" with title "عون Aoun"' >/dev/null 2>&1
  open "$ROOT/Aoun.app"
  for i in $(seq 1 180); do up && break; sleep 1; done
fi
if up; then open "$URL"; else
  osascript -e 'display dialog "تعذّر فتح قاعدة البيانات. شغّل Aoun أولاً ثم حاول مرة أخرى. / Could not open the database. Start Aoun first, then try again." with title "عون Aoun" buttons {"OK"} default button 1 with icon stop' >/dev/null 2>&1
fi
