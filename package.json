{
  "name": "aoun",
  "version": "1.0.0",
  "private": true,
  "description": "Aoun (عون) — unified medical imaging & emergency information web platform (MVP / demo)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "demo:assets": "python3 scripts/generate_demo_assets.py",
    "test": "vitest run",
    "setup:env": "bash scripts/setup-env.sh",
    "test:acceptance": "vitest run tests/acceptance.test.ts",
    "vercel-build": "node scripts/cloud-build.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dicom-parser": "^1.8.21",
    "dotenv": "^18.0.7",
    "embedded-postgres": "17.5.0-beta.15",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.55.0",
    "next": "^15.5.27",
    "node-forge": "^1.4.0",
    "passkit-generator": "^3.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
